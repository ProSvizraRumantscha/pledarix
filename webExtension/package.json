{
  "name": "pledarix",
  "version": "1.1.1",
  "description": "A browser extension which is translating words in Rumantsch when hovering with the mouse over the word.",
  "scripts": {
    "dev:chrome": "wxt -b chrome",
    "dev:firefox": "wxt -b firefox",
    "dev:edge": "wxt -b edge",
    "dev:opera": "wxt -b opera",
    "build:chrome": "wxt build -b chrome",
    "build:firefox": "wxt build -b firefox",
    "build:edge": "wxt build -b edge",
    "build:opera": "wxt build -b opera",
    "zip:chrome": "wxt zip -b chrome",
    "zip:firefox": "wxt zip -b firefox",
    "zip:edge": "wxt zip -b edge",
    "zip:opera": "wxt zip -b opera"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Prosvizrarumantscha/pledarix.git"
  },
  "keywords": [
    "rumantsch",
    "pledari"
  ],
  "author": "Pro Svizra Rumantscha",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Prosvizrarumantscha/pledarix/issues"
  },
  "homepage": "https://github.com/Prosvizrarumantscha/pledarix#readme",
  "devDependencies": {
    "typescript": "^7.0.2",
    "wxt": "^0.20.27"
  },
  "dependencies": {
    "jquery": "^3.7.0",
    "lru_map": "^0.4.1"
  },
  "packageManager": "pnpm@10.12.4+sha256.cadfd9e6c9fcc2cb76fe7c0779a5250b632898aea5f53d833a73690c77a778d9",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
